{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ES2022",
    "target": "ES2022",
    "outDir": "../../dist/out-tsc",
    "declaration": true,
    "types": ["node"],

    // See libs/native-federation/tsconfig.lib.json for the rationale.
    // Restores TS 5.x-equivalent looseness to match upstream's
    // commented-out `// "strict": true,` policy under TS 6's stricter
    // defaults. Going past this baseline belongs in a separate PR.
    "strict": false,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "exclude": ["jest.config.ts", "src/**/*.spec.ts", "src/**/*.test.ts"],
  "include": [
    "src/**/*.ts",
    "src/lib/node/import-map-store.ts.bak",
    "src/lib/node/federation-resolver.ts.bak",
    "../native-federation/tools/fstart-args-parser.ts",
    "../native-federation/tools/fstart.ts"
  ]
}
